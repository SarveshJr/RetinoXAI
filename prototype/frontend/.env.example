# RetinoXAI Frontend Environment Configuration
# Copy this file to .env.local for local overrides (never committed to git)

# Backend API base URL
# Leave commented or set to /api for local dev (proxies to http://127.0.0.1:8080)
# VITE_API_BASE=/api

# In Production (e.g. deployed to Vercel), set this in Vercel Project Settings:
# VITE_API_BASE=https://<your-backend-host>/api
